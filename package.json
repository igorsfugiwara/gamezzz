{
  "name": "gamezzz-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:jogos && next build",
    "start": "next start",
    "lint": "next lint",
    "build:jogos": "tsc -p jogos && vite build -c vite.jogos.config.ts",
    "dev:jogos": "vite -c vite.jogos.config.ts --port 5190",
    "test:jogos": "vitest run -c vite.jogos.config.ts"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "sass": "^1.100.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "typescript": "^5",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
